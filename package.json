{
  "name": "ai-trading-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone AI-assisted trading terminal \u2014 explainable signals, a mandatory risk engine, backtesting and paper trading. Analysis only; no order execution.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "start": "next start --port 4310",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"tests/unit/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.30.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  }
}
