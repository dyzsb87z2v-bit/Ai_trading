# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Password for the single local operator account.
# Change this before exposing the app to anything but localhost.
APP_PASSWORD=changeme

# Where the SQLite database lives. Defaults to ./data
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Binance public spot market data (crypto). Needs NO API key.
# Symbols are Binance spot pairs: BTCUSDT, ETHUSDT — not BTCUSD.
BINANCE_ENABLED=false
# Optional: a regional mirror (api1/api2/api3.binance.com) or a local proxy.
BINANCE_BASE_URL=

# Twelve Data — stocks, ETFs, indices, forex and crypto with one key.
# Registered ahead of Binance when both are on, because it covers every class.
TWELVEDATA_ENABLED=false
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=

# ---------------------------------------------------------------------------
# News, economic calendar and fundamentals
# ---------------------------------------------------------------------------
# One Finnhub key serves all three. Leave off and each reports itself
# unavailable rather than returning empty results that read as "nothing today".
FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_BASE_URL=

# ---------------------------------------------------------------------------
# Broker — READ ONLY unless you deliberately enable trading
# ---------------------------------------------------------------------------
# Defaults to Alpaca's PAPER host. Three independent switches stand between a
# connection and a live order, and all three must be set on purpose.
ALPACA_ENABLED=false
ALPACA_KEY_ID=
ALPACA_SECRET=
# Point at the live host instead of paper. Read this line twice.
ALPACA_LIVE=false
# Permit order submission at all. Without this the adapter refuses every order.
ALPACA_TRADING_ENABLED=false
ALPACA_BASE_URL=

# ---------------------------------------------------------------------------
# AI Copilot (optional)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave unset and the Copilot reports itself
# unavailable rather than inventing an analysis; every score and level on the
# page is still computed without it.
COPILOT_BASE_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
