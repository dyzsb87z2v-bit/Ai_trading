# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Password for the single local operator account.
# Change this before exposing the app to anything but localhost.
APP_PASSWORD=changeme

# Where the SQLite database lives. Defaults to ./data
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Binance public spot market data. Needs NO API key.
# Leave unset and the terminal runs on a clearly labelled SIMULATED series.
# Symbols are Binance spot pairs: BTCUSDT, ETHUSDT — not BTCUSD.
BINANCE_ENABLED=false
# Optional: a regional mirror (api1/api2/api3.binance.com) or a local proxy.
BINANCE_BASE_URL=

# ---------------------------------------------------------------------------
# AI Copilot (optional)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave unset and the Copilot reports itself
# unavailable rather than inventing an analysis; every score and level on the
# page is still computed without it.
COPILOT_BASE_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
